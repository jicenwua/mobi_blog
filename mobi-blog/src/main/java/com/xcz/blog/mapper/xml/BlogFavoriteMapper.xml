<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xcz.blog.mapper.BlogFavoriteMapper">

    <resultMap id="BlogFavoriteResult" type="com.xcz.blog.domain.BlogFavorite">
        <id property="favoriteId" column="favorite_id"/>
        <result property="userId" column="user_id"/>
        <result property="favoriteName" column="favorite_name"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <select id="selectByIdAndUserId" resultMap="BlogFavoriteResult">
        SELECT *
        FROM blog_favorite
        WHERE favorite_id = #{favoriteId}
          AND user_id = #{userId}
          AND del_flag = 0
        LIMIT 1
    </select>

    <select id="selectDefaultByUserId" resultMap="BlogFavoriteResult">
        SELECT *
        FROM blog_favorite
        WHERE user_id = #{userId}
          AND del_flag = 0
          AND (remark = 'DEFAULT' OR favorite_name = '默认收藏夹')
        ORDER BY CASE WHEN remark = 'DEFAULT' THEN 0 ELSE 1 END, favorite_id ASC
        LIMIT 1
    </select>

</mapper>
